{
  "name": "@mymoon-ai/migration-legacy",
  "version": "0.1.17",
  "description": "Migrate miki-cli (~/.miki/) data into miki-code (~/.miki-code/).",
  "license": "MIT",
  "type": "module",
  "private": true,
  "files": [
    "dist"
  ],
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mymoon-ai/agent-core-v2": "workspace:^",
    "smol-toml": "^1.6.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@mymoon-ai/transcript": "workspace:^"
  }
}
